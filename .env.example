# ==============================================================================
# EazyShop Environment Configuration Template (.env.example)
# ==============================================================================
# Duplicate this file as '.env' in the project root and replace placeholder
# values with your actual development or production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key used for cryptographic signing. Generate a strong key for production.
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-secret-key-for-production

# Set to True for local development, False for production deployments.
DEBUG=True

# Primary frontend URL for outbound transactional email links & notifications.
FRONTEND_URL=https://eazyshop.cfd

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / NeonDB / SQLite)
# ------------------------------------------------------------------------------
# Full connection URI for PostgreSQL. Supports Neon, AWS RDS, Supabase, etc.
# Local SQLite fallback: sqlite:///db.sqlite3
DATABASE_URL=postgresql://db_user:db_password@ep-sample-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Razorpay API credentials (obtain from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# Secret used to verify Razorpay webhooks (set under Settings > Webhooks in Razorpay dashboard)
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA STORAGE
# ------------------------------------------------------------------------------
# Media asset cloud storage for product images and user profile pictures.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyza@your-cloud-name

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL SERVICE (Brevo / Anymail / SMTP)
# ------------------------------------------------------------------------------
# Brevo (formerly Sendinblue) v3 API key for sending branded HTML emails
BREVO_API_KEY=xkeysib-replace-with-your-brevo-v3-api-key-here

# Sender email address displayed in outgoing customer and vendor emails
DEFAULT_FROM_EMAIL=updates.eazyshop@gmail.com

# Optional SMTP fallback credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=updates.eazyshop@gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# ------------------------------------------------------------------------------
# 6. FRONTEND CONFIGURATION (React / Vercel)
# ------------------------------------------------------------------------------
# Target backend API base URL for Axios instances in frontend/src/context/AuthContext.js
# In development: http://127.0.0.1:8000
# In production: https://eazyshop-api.onrender.com (or your live backend domain)
REACT_APP_API_URL=http://127.0.0.1:8000
